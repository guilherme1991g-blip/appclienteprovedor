{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "ios": {
        "simulator": false
      }
    },
    "production:cbrfibra": {
      "extends": "production",
      "env": {
        "APP_PROVIDER": "cbrfibra"
      }
    },
    "production:webconnect": {
      "extends": "production",
      "env": {
        "APP_PROVIDER": "webconnect"
      }
    }
  },
  "submit": {
    "production": {},
    "production:webconnect": {
      "ios": {
        "ascAppId": "6808270079"
      }
    }
  }
}
